git clone https://git.ffmpeg.org/ffmpeg.git ffmpeg
cd ffmpeg


make distclean
make clean


CFLAGS="-Os -ffunction-sections -fdata-sections" \
LDFLAGS="-Wl,--gc-sections" \
./configure \
  --target-os=mingw32 \
  --arch=x86_64 \
  --cross-prefix=x86_64-w64-mingw32- \
  --prefix="$PWD/build/window" \
  --enable-small \
  --enable-pic \
  --disable-shared \
  --enable-static \
  --disable-everything \
  --disable-doc \
  --disable-debug \
  --disable-network \
  --disable-autodetect \
  --disable-avdevice \
  --enable-avutil \
  --enable-avcodec \
  --enable-avformat \
  --enable-avfilter \
  --enable-swresample \
  --enable-swscale \
  --enable-zlib \
  \
  --disable-bsfs \
  --disable-hwaccels \
  --disable-parsers \
  \
  --enable-parser=h264 \
  --enable-parser=hevc \
  --enable-parser=mpegaudio \
  --enable-parser=aac \
  --enable-parser=vp9 \
  --enable-parser=av1 \
  \
  --enable-demuxer=mov \
  --enable-demuxer=matroska \
  --enable-demuxer=ogg \
  --enable-demuxer=mp3 \
  --enable-demuxer=flac \
  --enable-demuxer=wav \
  --enable-demuxer=aac \
  --enable-demuxer=image2 \
  \
  --enable-muxer=mov \
  --enable-muxer=matroska \
  --enable-muxer=ogg \
  --enable-muxer=mp3 \
  --enable-muxer=flac \
  --enable-muxer=wav \
  --enable-muxer=image2 \
  \
  --enable-decoder=h264 \
  --enable-decoder=hevc \
  --enable-decoder=mpeg4 \
  --enable-decoder=vp8 \
  --enable-decoder=vp9 \
  --enable-decoder=av1 \
  --enable-decoder=mjpeg \
  --enable-decoder=png \
  --enable-decoder=aac \
  --enable-decoder=mp3 \
  --enable-decoder=flac \
  --enable-decoder=opus \
  --enable-decoder=vorbis \
  --enable-decoder=alac \
  --enable-decoder=pcm_s16le \
  --enable-decoder=pcm_s24le \
  --enable-decoder=pcm_f32le \
  \
  --enable-encoder=mjpeg \
  --enable-encoder=png \
  --enable-encoder=flac \
  \
  --enable-filter=format \
  --enable-filter=scale \
  --enable-filter=select \
  --enable-filter=signalstats \
  --enable-filter=metadata \
  --enable-filter=fps \
